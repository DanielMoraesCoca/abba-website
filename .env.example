# Chave da API da Anthropic. Sem ela o site funciona: a Análise ABBA cai no
# texto determinístico e o número, que nunca dependeu do modelo, sai igual.
ANTHROPIC_API_KEY=

# Domínio canônico. Só existe para ambiente de pré-visualização — em produção
# o padrão já é https://abbaservices.com.br. Nunca apontar para URL de
# plataforma em material que chegue a prospect.
NEXT_PUBLIC_SITE_URL=

# Para onde os contatos do site são encaminhados (webhook do funil).
# Sem ela, o formulário funciona e o contato fica no log do servidor.
ABBA_LEAD_WEBHOOK=

# Limite de requisições por IP, por janela (análise: 10 min · contato: 15 min).
# Sem elas, valem os padrões de produção (8 e 5). Existem para ambientes que
# precisam de outro número — o conjunto de testes é um deles. Valor ausente,
# vazio ou inválido cai no padrão: configuração errada nunca abre a porta.
ABBA_LIMITE_ANALISE=
ABBA_LIMITE_CONTATO=
