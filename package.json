{
  "name": "abba-website",
  "version": "0.1.0",
  "private": true,
  "description": "Site institucional da ABBA Consultoria de IA — abbaservices.com.br",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
